# Canonical app origin. Production must be HTTPS and must not be a Vercel
# preview URL, e.g. https://repdrill.example.com.
SITE_URL=http://localhost:3000

# WorkOS AuthKit
# Use the Production environment's values in production; staging keys are not
# interchangeable with production keys.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must be registered in WorkOS as: ${SITE_URL}/auth/callback
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# AuthKit also reads this public name when calculating cookie settings. Keep it
# equal to WORKOS_REDIRECT_URI in local and deployed environments.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=
# Optional custom cookie name; leave unset for the AuthKit default.
WORKOS_COOKIE_NAME=

# Supabase Postgres. Use the Shared Pooler connection string with SSL.
SUPABASE_DB_URL=
# Only the migration script needs these; never expose the service role key to browsers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COUNTER_REFRESH_SECRET=
# DATABASE_URL is retained as a backwards-compatible alias for the importer.
DATABASE_URL=
# Root domain for allow-listed course shortcuts such as woodpecker.example.com.
# Production also needs wildcard DNS, TLS, and hosting-domain configuration.
COURSE_ALIAS_ROOT_DOMAIN=
# Read-only source deployment used only while exporting the legacy database.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional private source for the authenticated Woodpecker correction viewer.
# Use a private host or Convex Storage URL; this server-only value is proxied
# and is never sent to the browser. Leave unset to disable the preview safely.
WOODPECKER_SOURCE_PDF_URL=
# Optional when the private host requires Authorization: Bearer <token>.
WOODPECKER_SOURCE_PDF_BEARER_TOKEN=

# Resend email invitations
# Replace re_xxxxxxxxx with your real Resend API key.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
