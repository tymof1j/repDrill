# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Google Cloud Console → OAuth 2.0 Client IDs
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Convex Auth keys generated during setup
JWT_PRIVATE_KEY=
JWKS=

# Convex deployment values
CONVEX_DEPLOYMENT=
